FROM python:3.12-slim
# Кодер — только вызовы модели и быстрые проверки кода: без .NET/Node, сборку делает агент
WORKDIR /app
COPY services/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY common/ /common/
ENV PYTHONPATH=/common
COPY services/backend/ .
CMD ["uvicorn","coder_main:app","--host","0.0.0.0","--port","8000"]
